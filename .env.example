# ==================================
# APPLICATION CONFIGURATION
# ==================================

# Environment: development, production, test
NODE_ENV=production

# Server port
PORT=5000

# ==================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==================================

# For Docker: use 'postgres' as host
# For local setup: use 'localhost' as host
DB_HOST=postgres
DB_USER=myapp_user
DB_PASSWORD=myapp_password
DB_NAME=myapp_db
DB_PORT=5432

# ==================================
# REDIS CONFIGURATION (Optional)
# ==================================

# For Docker: use 'redis' as host
# For local setup: use 'localhost' as host
# Redis is used for caching and session management
REDIS_HOST=redis
REDIS_PORT=6379

# ==================================
# JWT AUTHENTICATION
# ==================================

# IMPORTANT: Change these secrets in production!
# Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Secret key for access tokens
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Secret key for refresh tokens
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production

# Token expiration times
# Format: 1h, 24h, 7d, 30d, etc.
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=90d

# ==================================
# RATE LIMITING
# ==================================

# Time window for rate limiting (in milliseconds)
# 900000 = 15 minutes
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Rate limit for authentication endpoints
AUTH_RATE_LIMIT_MAX=5

# ==================================
# LOGGING CONFIGURATION
# ==================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

# ==================================
# EMAIL CONFIGURATION (Optional)
# ==================================

# Uncomment and configure if you want to use email features
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_FROM=noreply@yourapp.com

# ==================================
# CORS CONFIGURATION (Optional)
# ==================================

# Allowed origins for CORS (comma-separated)
# Example: https://yourfrontend.com,https://app.yoursite.com
# CORS_ORIGIN=*

# ==================================
# UPLOAD CONFIGURATION (Optional)
# ==================================

# Maximum file upload size (in bytes)
# 5242880 = 5MB
# MAX_UPLOAD_SIZE=5242880

# Allowed file types for upload
# ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg

# ==================================
# SOCKET.IO CONFIGURATION (Optional)
# ==================================

# Socket.IO origins (for real-time features)
# SOCKET_ORIGINS=*

# ==================================
# ADMIN CONFIGURATION (Optional)
# ==================================

# Default admin credentials (for first-time setup)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change_this_password

# ==================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ==================================

# 1. Always change JWT_SECRET and JWT_REFRESH_SECRET
# 2. Use strong database passwords
# 3. Set NODE_ENV=production
# 4. Configure proper CORS origins
# 5. Set up SSL/TLS certificates
# 6. Configure email service for notifications
# 7. Set up proper logging and monitoring
# 8. Use environment-specific values for DB_HOST and REDIS_HOST
# 9. Regular backups of database
# 10. Keep dependencies updated

# ==================================
# DOCKER-SPECIFIC NOTES
# ==================================

# When running with Docker Compose:
# - DB_HOST should be 'postgres' (service name)
# - REDIS_HOST should be 'redis' (service name)
# - These are automatically configured in docker-compose.yml

# When running locally without Docker:
# - DB_HOST should be 'localhost'
# - REDIS_HOST should be 'localhost'
# - Make sure PostgreSQL and Redis are installed and running
